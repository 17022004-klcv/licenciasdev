# Secreto para firmar los JWT. Obligatorio: la app no arranca el login sin él.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Ruta absoluta del archivo SQLite. En producción (Render) debe apuntar al
# disco persistente, por ejemplo: /var/data/licencias.db
# Si se omite, usa ./licencias.db (solo recomendado en local).
DATABASE_PATH=
